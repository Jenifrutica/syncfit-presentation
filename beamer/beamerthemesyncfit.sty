% SyncFit Edge Beamer theme: the brand of the app (syncfit-frontend/app/tokens.css).
% Pink sky, deep indigo ink, cloud shapes, dripping edges and Pulsi.
% Compile with XeLaTeX (fontspec loads Fredoka + Nunito from ./fonts).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemesyncfit}[2026/11/19 SyncFit Edge brand theme]

\RequirePackage{fontspec}
\RequirePackage{tikz}
\usetikzlibrary{svg.path,positioning,calc,shadows}
\RequirePackage{graphicx}

% ---------- Colors (same hex as app/tokens.css) ----------
\definecolor{rosa}{HTML}{F1CCDE}
\definecolor{rosaclaro}{HTML}{F7E4EE}
\definecolor{nube}{HTML}{FFFAFC}
\definecolor{crema}{HTML}{F4E1C1}
\definecolor{ink}{HTML}{2A1D65}
\definecolor{inksuave}{HTML}{4A3D85}
\definecolor{lavanda}{HTML}{5E5290}
\definecolor{lavandanoche}{HTML}{3B2E80}
\definecolor{lavandatexto}{HTML}{E9E2FF}
\definecolor{menstrual}{HTML}{F08A7E}
\definecolor{menstrualsuave}{HTML}{FBD1CB}
\definecolor{folicular}{HTML}{8FD3B6}
\definecolor{folicularsuave}{HTML}{D3F1E4}
\definecolor{ovulatoria}{HTML}{F7C75C}
\definecolor{ovulatoriasuave}{HTML}{FCE6AE}
\definecolor{lutea}{HTML}{B9ACEB}
\definecolor{luteasuave}{HTML}{E3DCFA}
\definecolor{gestacion}{HTML}{F6B48A}
\definecolor{gestacionsuave}{HTML}{FDE1CF}

% ---------- Fonts ----------
\setsansfont{Nunito}[Path=fonts/, Extension=.ttf, UprightFont=*-Regular, BoldFont=*-ExtraBold]
\newfontfamily\display{Fredoka}[Path=fonts/, Extension=.ttf, UprightFont=*-Bold, BoldFont=*-Bold]
\newfontfamily\displaymedium{Fredoka}[Path=fonts/, Extension=.ttf, UprightFont=*-Medium]
\renewcommand{\familydefault}{\sfdefault}
% No word splitting: big pitch type reads better whole (and the default patterns are English).
\lefthyphenmin=62

% ---------- Shapes (paths from components/decor/) ----------
% Cloud: CLOUD_PATH in Cloud.tsx (viewBox 200x110, y grows downward).
\newcommand{\nube}[3][nube]{% [color]{$tikz coordinate$}{width in cm}
  \begin{scope}[shift={(#2)}, xscale=#3*0.14226, yscale=-#3*0.14226]% svg.path units are pt: 1cm = 28.4527pt over 200 units
    \fill[#1] svg {M40 100 C14 100 4 78 18 64 C8 44 30 26 52 36 C56 14 92 6 106 28 C122 10 160 18 158 46 C186 46 196 76 176 90 C170 100 160 100 150 100 Z};
  \end{scope}}
% Dripping edge: the "gotea" path in DripDivider.tsx (viewBox 1440x110).
\newcommand{\gotea}[2]{% {color}{height in cm}, anchored at the top of the slide
  \begin{scope}[shift={(current page.north west)}, xscale=0.31614, yscale=-#2*0.25866]% 16cm wide page = 455.24pt over 1440; 1cm = 28.4527pt over 110
    \fill[#1] svg {M0 0 L1440 0 L1440 30 C1380 30 1370 78 1330 78 C1290 78 1300 26 1220 26 C1120 26 1100 60 1010 60 C960 60 966 86 930 86 C892 86 900 34 830 34 C720 34 700 64 600 64 C540 64 548 88 510 88 C472 88 480 28 400 28 C300 28 280 56 190 56 C140 56 150 80 110 80 C70 80 76 32 0 32 Z};
  \end{scope}}

% ---------- Beamer chrome ----------
\setbeamercolor{background canvas}{bg=rosa}
% Slide color: sets the canvas and the tones the decoration and card shadows use.
% [accent] colors the big corner sun.
\colorlet{fondo}{rosa}\colorlet{acento}{rosa!72!nube}
\newcommand{\fondo}[2][]{\setbeamercolor{background canvas}{bg=#2}\colorlet{fondo}{#2}%
  \if\relax\detokenize{#1}\relax\colorlet{acento}{#2!72!nube}\else\colorlet{acento}{#1}\fi}
% Solid (no transparency) shadow under cards, a deeper tone of the slide color.
\tikzset{sombra/.style={drop shadow={shadow xshift=0pt, shadow yshift=-4pt, fill=fondo!82!ink, opacity=1}}}
% Four-point sparkle. {color}{center}{size}
\newcommand{\chispa}[3]{\fill[#1] ($#2+(0,#3)$) .. controls ($#2+(.12*#3,.12*#3)$) .. ($#2+(#3,0)$) .. controls ($#2+(.12*#3,-.12*#3)$) .. ($#2+(0,-#3)$) .. controls ($#2+(-.12*#3,-.12*#3)$) .. ($#2+(-#3,0)$) .. controls ($#2+(-.12*#3,.12*#3)$) .. cycle;}
% Decoration behind every slide, kept to the corners and the footer so it
% never sits under text: a big soft sun top right, a ring, a small sun bottom
% left under the wordmark, sparkles and the four phase dots in the footer.
\setbeamertemplate{background}{%
  \begin{tikzpicture}[remember picture, overlay]
    \coordinate (ne) at (current page.north east);
    \coordinate (sw) at (current page.south west);
    \fill[acento] ($(ne)+(-.2,.3)$) circle (2.35);
    \fill[fondo!72!nube] ($(ne)+(-.2,.3)$) circle (1.2);
    \draw[fondo!80!ink, line width=3pt] ($(ne)+(-2.75,-1.55)$) circle (.42);
    \fill[fondo!72!nube] ($(sw)+(.2,-.5)$) circle (1.35);
    \chispa{fondo!70!ink}{($(ne)+(-3.6,-.55)$)}{.2}
    \chispa{fondo!70!ink}{($(ne)+(-.45,-3.0)$)}{.14}
    \chispa{fondo!70!ink}{($(sw)+(2.9,.95)$)}{.11}
    \foreach \c [count=\i] in {menstrual,folicular,ovulatoria,lutea}
      \fill[\c] ($(current page.south)+(-.75+\i*.3,.55)$) circle (.08);
  \end{tikzpicture}}
\setbeamercolor{normal text}{fg=ink}
\setbeamercolor{structure}{fg=ink}
\setbeamercolor{frametitle}{fg=ink}
\setbeamerfont{frametitle}{family=\display, size=\huge}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{itemize item}{\color{ink}\raisebox{.15ex}{\tikz\fill[ink] (0,0) circle (.6ex);}}
\setbeamertemplate{frametitle}{\vspace*{.2cm}\insertframetitle\par}

% Small pill with the minute range of each slide, e.g. "02:00 – 05:00".
\newcommand{\minutos}[1]{%
  \tikz[baseline=(t.base)]\node[fill=nube, text=inksuave, rounded corners=7pt, inner xsep=8pt, inner ysep=3pt, font=\small\bfseries](t){#1};}

% Footer: wordmark + part of the talk + slide number.
\newcommand{\parte}{El problema}
% The footer reserves 1 cm (an empty strut) so slide content always ends above it.
\newcommand{\reservapie}{\hbox{\vrule width 0pt height 1cm}}
\setbeamertemplate{footline}{%
  \reservapie
  \begin{tikzpicture}[remember picture, overlay]
    \node[anchor=south west, inner sep=0pt] at ($(current page.south west)+(.6,.35)$)
      {\includegraphics[height=.42cm]{img/pulsi.png}\hspace{4pt}{\display\color{ink}\normalsize syncfit}};
    \node[anchor=south east, font=\footnotesize\bfseries, text=inksuave] at ($(current page.south east)+(-.6,.42)$)
      {\parte\ \textperiodcentered\ \insertframenumber\ de \inserttotalframenumber};
  \end{tikzpicture}}

% Rounded "cloud card" used across slides (cards in the app: radius-nube).
\newcommand{\tarjeta}[4]{% {fill}{width}{title}{body}
  \begin{tikzpicture}[baseline=(current bounding box.north)]
    \node[fill=#1, sombra, rounded corners=14pt, inner sep=10pt, text width=#2, align=left]
      {{\display\normalsize #3}\par\vspace{2pt}{\scriptsize\hyphenpenalty=10000\exhyphenpenalty=10000 #4}};
  \end{tikzpicture}}

% ---------- Pitch building blocks ----------
% Huge headline and short lead (one idea per slide).
\newcommand{\titular}[2][34]{{\display\fontsize{#1}{#1}\selectfont #2\par}}
\newcommand{\bajada}[1]{{\fontsize{14}{18}\selectfont #1\par}}

% Speech bubble in ink, like Pulsi's in the app.
\newcommand{\burbuja}[2][ink]{%
  \tikz[baseline=(b.base)]\node[fill=#1, text=nube, rounded corners=12pt, inner xsep=12pt, inner ysep=7pt, font=\display\large](b){#2};}

% Numbered step chip: big number in a colored circle + text.
\newcommand{\paso}[3]{% {circle color}{number}{text}
  \begin{tikzpicture}[baseline=(t.base)]
    \node[circle, fill=#1, text=ink, minimum size=1.05cm, font=\display\Large](n){#2};
    \node[right=6pt of n, text width=5.6cm, align=left, font=\large](t){\hyphenpenalty=10000 #3};
  \end{tikzpicture}}

% Icons drawn in TikZ (no icon font needed), sized by the current tikz scale.
\newcommand{\iconoCiclo}{%
  \foreach \c/\a in {menstrual/0, folicular/90, ovulatoria/180, lutea/270}
    \draw[\c, line width=5pt] (0,0) ++(\a:.55) arc (\a:\a+80:.55);
  \fill[ink] (0,0) circle (.12);}
\newcommand{\iconoEnergia}{%
  \draw[ink, line width=2.4pt, rounded corners=3pt] (-.55,-.3) rectangle (.45,.3);
  \fill[ink] (.48,-.12) rectangle (.6,.12);
  \foreach \x in {-.42,-.16,.1} \fill[folicular] (\x,-.18) rectangle ++(.2,.36);}
\newcommand{\iconoEquipo}{%
  \fill[ink, rounded corners=1pt] (-.42,-.05) rectangle (.42,.05);
  \foreach \s in {-1,1} {\fill[ink, rounded corners=2pt] (\s*.42-.07,-.3) rectangle (\s*.42+.07,.3);
    \fill[ink, rounded corners=2pt] (\s*.58-.06,-.2) rectangle (\s*.58+.06,.2);}}
\newcommand{\iconoGym}{%
  \fill[ink] (-.55,-.4) rectangle (.55,.15); \fill[ink] (-.65,.15) -- (0,.55) -- (.65,.15) -- cycle;
  \fill[crema] (-.15,-.4) rectangle (.15,-.05);}
\newcommand{\iconoAtleta}{%
  \fill[ink] (0,.32) circle (.2); \fill[ink, rounded corners=8pt] (-.38,-.45) rectangle (.38,.08);}
\newcommand{\iconoEscudo}{%
  \fill[ink] (0,.5) -- (.45,.32) -- (.4,-.1) .. controls (.3,-.35) .. (0,-.5) .. controls (-.3,-.35) .. (-.4,-.1) -- (-.45,.32) -- cycle;
  \draw[nube, line width=2pt, line cap=round, line join=round] (-.18,0) -- (-.03,-.15) -- (.2,.12);}
\newcommand{\iconoPulso}{%
  \draw[ink, line width=2.6pt, line cap=round, line join=round] (-.6,0) -- (-.25,0) -- (-.12,.35) -- (.05,-.4) -- (.2,.15) -- (.3,0) -- (.6,0);}
\newcommand{\iconoChip}{%
  \fill[ink, rounded corners=3pt] (-.36,-.36) rectangle (.36,.36);
  \fill[nube] (-.15,-.15) rectangle (.15,.15);
  \foreach \t in {-.2,0,.2} {\fill[ink] (\t-.04,.36) rectangle (\t+.04,.52); \fill[ink] (\t-.04,-.52) rectangle (\t+.04,-.36);
    \fill[ink] (.36,\t-.04) rectangle (.52,\t+.04); \fill[ink] (-.52,\t-.04) rectangle (-.36,\t+.04);}}
\newcommand{\iconoChispa}{%
  \fill[ink] (0,.55) .. controls (.08,.1) .. (.5,0) .. controls (.08,-.1) .. (0,-.55) .. controls (-.08,-.1) .. (-.5,0) .. controls (-.08,.1) .. cycle;
  \fill[ink] (.38,.38) circle (.08);}
% Round icon badge: {fill}{icon macro}.
% sharp corners: a nested picture would otherwise inherit the card's rounded corners.
\newcommand{\insignia}[2]{\tikz[baseline=-.6ex, sharp corners]{\fill[#1] (0,0) circle (.68); \begin{scope}[scale=.78] #2 \end{scope}}}

% ---------- Animations (animate package; play in Adobe Acrobat/Reader) ----------
% Every animation plays ONCE when its page opens and stays on its last frame
% (the cover's floating Pulsi is the only loop). Each one first holds its start
% frame ~0.6 s (rate 1.6, then \newframe[...]) so it does not finish hidden
% behind the slide transition.
% Each has a still twin (\...fijo) for the next reveal pages of the same slide,
% so clicking to reveal a card never replays it. Animations are drawn above
% page content in a PDF, so they are only placed where there is no text.
% Viewers without JavaScript show the last frame, which is a complete picture.
\RequirePackage{animate}
\newcommand{\facil}[1]{(1-(1-(#1))^3)}% ease-out

% Pulsi rising into place with a small bounce. {height in cm}
\newcommand{\cuadropulsi}[2]{% {height}{progress 0..1}
  \begin{tikzpicture}
    \useasboundingbox (0,0) rectangle (#1*.95,#1*1.25);
    \pgfmathsetmacro\e{\facil{#2}}
    \node[inner sep=0pt] at (#1*.475, {#1*.6 - #1*.35*(1-\e) + #1*.05*sin(\e*540)}) {\includegraphics[height=#1 cm]{img/pulsi.png}};
  \end{tikzpicture}}
\newcommand{\pulsiflota}[1]{%
  \begin{animateinline}[autoplay,poster=last]{1.6}
    \cuadropulsi{#1}{0}\newframe[24]
    \multiframe{36}{rA=0.0278+0.0278}{\cuadropulsi{#1}{\rA}}
  \end{animateinline}}
\newcommand{\pulsifijo}[1]{\cuadropulsi{#1}{1}}

% Cover: Pulsi floats and sways in a gentle endless loop. {height in cm}
\newcommand{\cuadrobaile}[2]{% {height}{phase 0..1}
  \begin{tikzpicture}
    \useasboundingbox (0,0) rectangle (#1*.95,#1*1.25);
    \fill[ink, opacity=.12] (#1*.475,#1*.04) ellipse ({#1*(.24-.04*sin(#2*360))} and #1*.035);
    \node[inner sep=0pt, rotate={4*sin(#2*360+90)}] at (#1*.475, {#1*.64 + #1*.07*sin(#2*360)}) {\includegraphics[height=#1 cm]{img/pulsi.png}};
  \end{tikzpicture}}
\newcommand{\pulsibaila}[1]{%
  \begin{animateinline}[autoplay,loop,poster=first]{20}
    \multiframe{50}{rB=0+0.02}{\cuadrobaile{#1}{\rB}}
  \end{animateinline}}

% Heart-rate line drawn once from left to right. {width in cm}{color}
\newcommand{\ecg}[1]{((mod(#1,16)>6 && mod(#1,16)<10) ? (mod(#1,16)<8 ? .8*(mod(#1,16)-6)/2 - .1 : .7 - .9*(mod(#1,16)-8)) : .08*sin(#1*90))}
\newcommand{\cuadroonda}[3]{% {width}{color}{step 1..48}
  \begin{tikzpicture}[x=#1cm/48, y=1cm]
    \useasboundingbox (0,-.7) rectangle (48,.9);
    \draw[#2!35, line width=2pt, line cap=round] (0,0) -- (48,0);
    \draw[#2, line width=3pt, line cap=round, line join=round] plot[domain=0:#3, samples=#3*3+2, smooth] (\x, {\ecg{\x}});
    \fill[#2] (#3, {\ecg{#3}}) circle (.12);
  \end{tikzpicture}}
\newcommand{\ondapulso}[2]{%
  \begin{animateinline}[autoplay,poster=last]{1.6}
    \cuadroonda{#1}{#2}{1}\newframe[18]
    \multiframe{47}{iT=2+1}{\cuadroonda{#1}{#2}{\iT}}
  \end{animateinline}}

% Pulsi on a track with N stops, at progress p (0 = first stop, 1 = last).
\newcommand{\cuadroviaje}[3]{% {width}{stops}{progress}
  \begin{tikzpicture}
    \useasboundingbox (-.45,-.25) rectangle (#1+.45,1.25);
    \pgfmathsetmacro\px{.18+(#1-.36)*(#3)}
    \fill[nube, rounded corners=3pt] (.18,-.1) rectangle (#1-.18,.1);
    \fill[ink, rounded corners=3pt] (.18,-.1) rectangle (\px,.1);
    \foreach \k in {1,...,#2} {\pgfmathsetmacro\sx{.18+(#1-.36)*(\k-1)/(#2-1)} \fill[ink] (\sx,0) circle (.18);}
    \node[inner sep=0pt] at (\px, .64) {\includegraphics[height=.9cm]{img/pulsi.png}};
  \end{tikzpicture}}
% Moves once from one progress to another. {width}{stops}{from}{to}
\newcommand{\pulsiviaja}[4]{%
  \begin{animateinline}[autoplay,poster=last]{1.6}
    \cuadroviaje{#1}{#2}{#3}\newframe[24]
    \multiframe{36}{rV=0.0278+0.0278}{\cuadroviaje{#1}{#2}{#3+(#4-#3)*\facil{\rV}}}
  \end{animateinline}}
\newcommand{\pulsiquieto}[3]{\cuadroviaje{#1}{#2}{#3}}

% The melting edge rising once over the previous section's color: three solid
% layers, the back one first. {width}{height} in cm, {previous}{back}{mid}{front}, {progress}
\newcommand{\cuadrogoteo}[7]{%
  \begin{tikzpicture}
    \useasboundingbox (0,0) rectangle (#1,#2);
    \clip (0,0) rectangle (#1,#2);
    \fill[#3] (0,0) rectangle (#1,#2);
    \foreach \c/\l/\h in {#4/0/1, #5/.15/.8, #6/.3/.6} {
      \pgfmathsetmacro\q{max(0,min(1,(#7-\l)/(1-\l)))}
      \pgfmathsetmacro\e{\facil{\q}}
      \begin{scope}[shift={(0,\e*\h*#2)}, xscale=#1*28.4527/1440, yscale=-\h*#2*28.4527/110]
        \fill[\c] svg {M1440 30 C1380 30 1370 78 1330 78 C1290 78 1300 26 1220 26 C1120 26 1100 60 1010 60 C960 60 966 86 930 86 C892 86 900 34 830 34 C720 34 700 64 600 64 C540 64 548 88 510 88 C472 88 480 28 400 28 C300 28 280 56 190 56 C140 56 150 80 110 80 C70 80 76 32 0 32 L0 330 L1440 330 Z};
      \end{scope}}
  \end{tikzpicture}}
\newcommand{\goteosube}[6]{%
  \begin{animateinline}[autoplay,poster=last]{1.6}
    \cuadrogoteo{#1}{#2}{#3}{#4}{#5}{#6}{0}\newframe[24]
    \multiframe{48}{rG=0.0208+0.0208}{\cuadrogoteo{#1}{#2}{#3}{#4}{#5}{#6}{\rG}}
  \end{animateinline}}
\newcommand{\goteofijo}[6]{\cuadrogoteo{#1}{#2}{#3}{#4}{#5}{#6}{1}}

% Clouds that drift in once and settle, for an empty corner. {width}{height}
\newcommand{\cuadronubes}[3]{%
  \begin{tikzpicture}
    \useasboundingbox (0,0) rectangle (#1,#2);
    \clip (0,0) rectangle (#1,#2);
    \pgfmathsetmacro\e{\facil{#3}}
    \nube{{#1-3.6+2.5*(1-\e)}, #2*.45}{3.2}
    \nube[nube!80!rosa]{{#1-5.8+3.5*(1-\e)}, #2*.05}{2.4}
  \end{tikzpicture}}
\newcommand{\nubesllegan}[2]{%
  \begin{animateinline}[autoplay,poster=last]{1.6}
    \cuadronubes{#1}{#2}{0}\newframe[24]
    \multiframe{40}{rN=0.025+0.025}{\cuadronubes{#1}{#2}{\rN}}
  \end{animateinline}}

